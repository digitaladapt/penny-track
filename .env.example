# ── Example environment for Penny-Track ────────────────────────────────────
# Copy this file to `.env` and adjust the values for your environment.
# You can also override any of these via real environment variables (which
# take precedence over .env files) or an uncommitted `.env.local` file.
#
# DO NOT commit `.env` or `.env.local` — Symfony's .gitignore excludes them.

###> symfony/framework-bundle ###
APP_ENV=prod
# Generate a 64-char random hex string, e.g.:  php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Base URL used when generating URLs in non-HTTP contexts (CLI commands).
DEFAULT_URI=https://penny.example.com
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/penny_track.db"
###< doctrine/doctrine-bundle ###

###> penny-track/llm ###
# Any OpenAI-compatible chat-completions endpoint (OpenAI, Ollama, LM Studio…)
LLM_API_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=change-me
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=10
###< penny-track/llm ###

###> penny-track/parse-jobs ###
# Maximum number of LLM parse jobs to process concurrently
MAX_BACKGROUND_JOBS=2
# Timeout (seconds) for a single LLM parse job in the worker
LLM_WORKER_TIMEOUT=600
# How many times to retry a failed parse job before marking it as failed
PARSE_JOB_MAX_ATTEMPTS=1
###< penny-track/parse-jobs ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> penny-track/budget ###
# Monthly budget goal in dollars. Set to 0 to disable the budget line.
BUDGET_GOAL=0
###< penny-track/budget ###
