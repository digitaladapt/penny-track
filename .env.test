###> symfony/framework-bundle ###
APP_ENV=test
APP_SECRET=test-secret-not-for-production
APP_DEBUG=1
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/penny_track.db"
###< doctrine/doctrine-bundle ###

###> penny-track/llm ###
LLM_API_ENDPOINT=http://localhost:8080/v1/chat/completions
LLM_API_KEY=test-key
LLM_MODEL=test-model
LLM_TIMEOUT=5
###< penny-track/llm ###

###> penny-track/parse-jobs ###
MAX_BACKGROUND_JOBS=1
LLM_WORKER_TIMEOUT=30
PARSE_JOB_MAX_ATTEMPTS=1
###< penny-track/parse-jobs ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> penny-track/budget ###
BUDGET_GOAL=0
###< penny-track/budget ###