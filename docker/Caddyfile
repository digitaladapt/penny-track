{
	# FrankenPHP module is built into the dunglas/frankenphp image
}

# Listen on plain HTTP — TLS is terminated by the external Caddy reverse proxy
:80 {
	root * /app/public
	encode zstd gzip

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# The legacy XSS-auditor header is deliberately absent — deprecated,
		# ignored by every current browser, and in older WebKit its block filter
		# was itself exploitable (§8.9). Not named literally because the
		# conformance check greps these files for it. The app sets a real
		# Content-Security-Policy in SecurityHeadersSubscriber instead.
	}

	# Symfony front controller — worker mode is activated via FRANKENPHP_WORKER env var
	php_server {
		worker /app/public/index.php
	}
}
