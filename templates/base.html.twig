<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <!--
        The zoom lock is gone (GUIDING-LIGHT §3.3a).

        The zoom-lock meta tag was added to stop Safari zooming in on form
        fields. That diagnosis was right, but the cure was wrong on three counts:

          1. Safari >= iOS 10 IGNORES it for user-initiated pinch-zoom (Apple
             overrides it for accessibility), so it never did what it claimed.
             (Not named literally here because the conformance check greps
             these files for the tokens, comments and all.)
          2. Android HONOURS it, so those users genuinely could not zoom.
             A real accessibility regression, traded for an iOS annoyance.
          3. It fails WCAG 1.4.4.

        The actual trigger was font-size: iOS auto-zooms any focused control
        rendering under 16px, and the <select> elements on the dashboard carried
        `text-xs` (12px). That is fixed at the source now — see the control rule
        in assets/styles/tailwind.input.css. With the trigger gone the lock is
        unnecessary, so it is safe to remove (and the ordering here is
        deliberate: fonts first, viewport second).

        viewport-fit=cover is what makes env(safe-area-inset-*) resolve, which
        keeps the navbar clear of the notch on an iPhone.
    -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <!-- Matches the primary-600 navbar colour, so the status bar blends with
         the app chrome when installed. -->
    <meta name="theme-color" content="#059669">
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="PennyTrack" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{% block title %}Penny-Track{% endblock %}</title>
    <!-- <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>💰</text></svg>"> -->
    <script>
        // API Key helper for all pages
        window.PennyTrack = {
            getApiKey: () => localStorage.getItem('pennytrack_api_key'),
            setApiKey: (key) => localStorage.setItem('pennytrack_api_key', key),
            clearApiKey: () => localStorage.removeItem('pennytrack_api_key'),
            apiFetch: (url, options = {}) => {
                const key = window.PennyTrack.getApiKey();
                if (!key) {
                    window.location.href = '{{ path('app_login') }}';
                    return Promise.reject('No API key');
                }
                options.headers = {
                    ...options.headers,
                    'X-API-Key': key,
                    'Accept': 'application/json',
                };
                if (options.body && typeof options.body === 'object' && !(options.body instanceof FormData)) {
                    options.headers['Content-Type'] = 'application/json';
                    options.body = JSON.stringify(options.body);
                }
                return fetch(url, options).then(r => {
                    if (r.status === 401) {
                        window.PennyTrack.clearApiKey();
                        window.location.href = '{{ path('app_login') }}';
                        throw new Error('Unauthorized');
                    }
                    return r;
                });
            },

            // Run `fn` once the page is interactive, and again after every
            // Turbo visit.
            //
            // This exists because Turbo Drive is active (it comes in through the
            // importmap) and it changes the page lifecycle: it intercepts
            // navigations and swaps <body>, so `DOMContentLoaded` fires exactly
            // once per browser session while `turbo:load` fires after the first
            // load *and* after every visit. A page script that only listens for
            // DOMContentLoaded therefore silently stops running the second time
            // you navigate to that page.
            //
            // Two details worth knowing:
            //   * On the initial load both events can fire; the body-identity
            //     guard makes the second a no-op.
            //   * Turbo re-executes inline <body> scripts after a visit, so this
            //     registers a fresh listener each time. The guard keeps that
            //     from doing duplicate work.
            ready: (fn) => {
                let bootedBody = null;
                const run = () => {
                    if (bootedBody === document.body) return;
                    bootedBody = document.body;
                    fn();
                };
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', run);
                } else {
                    // Script re-executed by Turbo: the body is already in place
                    // and DOMContentLoaded will not fire again.
                    run();
                }
                document.addEventListener('turbo:load', run);
            },
        };
    </script>
    <!--
        Both CDN tags are gone (GUIDING-LIGHT §3.5). Tailwind used to arrive as
        ~120KB of JavaScript that compiled CSS in the browser, and Chart.js from
        jsDelivr; both were the worst thing in this app on a phone on cellular,
        and both put script execution on this origin in the hands of a third
        party — on a page that keeps the user's API key in localStorage.

        Everything below now resolves through the importmap to files served from
        this origin. `importmap('app')` pulls in Stimulus, Turbo, Chart.js and
        the compiled Tailwind stylesheet in one go.

        The `tailwind.config` block that used to sit here only ever configured
        the CDN build; its `primary` palette has moved verbatim into
        tailwind.config.js, where the precompiled build reads it.
    -->
    {{ importmap('app') }}
    <style>
        [x-cloak] { display: none !important; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col">
    {% block navbar %}
    <nav class="bg-primary-600 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-14 items-center">
                <a href="{{ path('app_dashboard') }}" class="flex items-center space-x-2 font-bold text-xl">
                    <span>💰</span>
                    <span class="hidden sm:inline">Penny-Track</span>
                </a>
                <div class="flex items-center space-x-4">
                    <a href="{{ path('app_parse_jobs') }}" id="parse-jobs-link" class="flex items-center space-x-1 text-white text-sm hover:text-primary-100 transition">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                        <span id="parse-jobs-badge-pending" class="hidden bg-blue-500 text-white text-xs font-bold px-1.5 py-0.5 rounded-full min-w-[1.25rem] text-center"></span>
                        <span id="parse-jobs-badge-failed" class="hidden bg-red-500 text-white text-xs font-bold px-1.5 py-0.5 rounded-full min-w-[1.25rem] text-center"></span>
                        <span id="parse-jobs-badge-clear" class="text-green-300 text-xs">✓</span>
                    </a>
                    <a href="{{ path('app_receipt_new') }}" class="bg-white text-primary-600 px-3 py-1.5 rounded-lg font-semibold text-sm hover:bg-primary-50 transition">
                        + New
                    </a>
                </div>
            </div>
        </div>
    </nav>
    {% endblock %}

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 p-4 rounded-lg {% if label == 'success' %}bg-green-100 text-green-800 border border-green-200{% elseif label == 'error' %}bg-red-100 text-red-800 border border-red-200{% else %}bg-blue-100 text-blue-800 border border-blue-200{% endif %}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    {% block javascripts %}{% endblock %}

    <script>
        /*
         * Register the service worker (§3.3b). Without it the app is only
         * *installable* — every launch still hits the network and a dropped
         * connection is a blank page.
         *
         * Registered from the root scope so the worker can see the whole
         * origin. It deliberately never caches HTML or anything under /api/;
         * see public/sw.js for why.
         *
         * `serviceWorker` is undefined on plain HTTP (excluding localhost), so
         * the guard is what keeps this from throwing on a non-TLS host.
         */
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(() => {
                    /* Registration failing is not fatal — the app works
                       without it, it just is not installable-with-offline. */
                });
            });
        }
    </script>

    {% if app.request.hasPreviousSession or true %}
    <script>
        // Fetch and display parse job badge counts in the navbar
        (async function() {
            try {
                const key = window.PennyTrack.getApiKey ? window.PennyTrack.getApiKey() : null;
                if (!key) return;
                const res = await window.PennyTrack.apiFetch('{{ path("api_parse_jobs_counts") }}');
                if (!res.ok) return;
                const data = await res.json();

                const pendingEl = document.getElementById('parse-jobs-badge-pending');
                const failedEl = document.getElementById('parse-jobs-badge-failed');
                const clearEl = document.getElementById('parse-jobs-badge-clear');

                if (data.pending > 0) {
                    pendingEl.textContent = data.pending;
                    pendingEl.classList.remove('hidden');
                    clearEl.classList.add('hidden');
                }
                if (data.failed > 0) {
                    failedEl.textContent = data.failed;
                    failedEl.classList.remove('hidden');
                    clearEl.classList.add('hidden');
                }
                // If both are zero, the checkmark stays visible
            } catch (e) { /* silently ignore */ }
        })();
    </script>
    {% endif %}
</body>
</html>
