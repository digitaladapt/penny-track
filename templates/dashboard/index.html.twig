{% extends 'base.html.twig' %}

{% block title %}Dashboard - Penny-Track{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Summary Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4" id="summary-cards">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            <p class="text-sm text-gray-500">This Month</p>
            <p class="text-2xl font-bold text-gray-900" id="summary-this-month">$0.00</p>
            <p class="text-xs" id="summary-change"></p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            <p class="text-sm text-gray-500">Last Month</p>
            <p class="text-2xl font-bold text-gray-900" id="summary-last-month">$0.00</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            <p class="text-sm text-gray-500">Transactions</p>
            <p class="text-2xl font-bold text-gray-900" id="summary-count">0</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            <p class="text-sm text-gray-500">Average</p>
            <p class="text-2xl font-bold text-gray-900" id="summary-avg">$0.00</p>
        </div>
    </div>

    <!-- Insights -->
    <div id="insights-container" class="hidden">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Insights</h2>
        <div class="space-y-2" id="insights-list"></div>
    </div>

    <!-- Stacked Budget Chart -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-semibold text-gray-700">Monthly Spending by Category</h3>
            <select id="budget-chart-months" class="text-xs border rounded-md px-2 py-1 bg-white">
                <option value="1">1 month</option>
                <option value="2" selected>2 months</option>
                <option value="3">3 months</option>
                <option value="4">4 months</option>
                <option value="6">6 months</option>
                <option value="12">12 months</option>
            </select>
        </div>
        <div class="h-80">
            <canvas id="budget-chart"></canvas>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <h3 class="text-sm font-semibold text-gray-700 mb-4">Spending Over Time (30 days)</h3>
        <div class="h-64">
            <canvas id="trend-chart"></canvas>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-semibold text-gray-700">Top Businesses</h3>
            <select id="top-businesses-limit" class="text-xs border rounded-md px-2 py-1 bg-white">
                <option value="5" selected>Show 5</option>
                <option value="10">Show 10</option>
                <option value="15">Show 15</option>
                <option value="25">Show 25</option>
            </select>
        </div>
        <div class="h-64">
            <canvas id="business-chart"></canvas>
        </div>
    </div>

    <!-- Recent Transactions -->
    <div>
        <div class="flex items-center justify-between mb-3">
            <h2 class="text-lg font-semibold text-gray-900">Recent Transactions</h2>
            <div class="flex items-center gap-3">
                <select id="recent-transactions-limit" class="text-xs border rounded-md px-2 py-1 bg-white">
                    <option value="10" selected>Show 10</option>
                    <option value="25">Show 25</option>
                    <option value="50">Show 50</option>
                    <option value="100">Show 100</option>
                </select>
                <a href="{{ path('app_receipt_new') }}" class="text-primary-600 text-sm font-medium hover:underline">+ Add New</a>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="text-left px-4 py-3 font-medium text-gray-700">Date</th>
                            <th class="text-left px-4 py-3 font-medium text-gray-700">Business</th>
                            <th class="text-left px-4 py-3 font-medium text-gray-700">Category</th>
                            <th class="text-right px-4 py-3 font-medium text-gray-700">Amount</th>
                            <th class="px-4 py-3"></th>
                        </tr>
                    </thead>
                    <tbody id="recent-transactions" class="divide-y divide-gray-100">
                        <tr><td colspan="5" class="px-4 py-8 text-center text-gray-500">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    let budgetChart, trendChart, businessChart;

    const formatCurrency = (n) => '$' + parseFloat(n).toFixed(2);
    const formatDate = (iso) => new Date(iso).toLocaleDateString();

    function getTopBusinessesLimit() {
        return parseInt(localStorage.getItem('pennyTrack_topBusinessesLimit') || '5', 10);
    }

    function getRecentTransactionsLimit() {
        return parseInt(localStorage.getItem('pennyTrack_recentTransactionsLimit') || '10', 10);
    }

    function getBudgetChartMonths() {
        return parseInt(localStorage.getItem('pennyTrack_budgetChartMonths') || '2', 10);
    }

    function loadBudgetChartMonths() {
        const selector = document.getElementById('budget-chart-months');
        if (selector) {
            selector.value = String(getBudgetChartMonths());
        }
    }

    function loadTopBusinessesLimit() {
        const selector = document.getElementById('top-businesses-limit');
        if (selector) {
            selector.value = String(getTopBusinessesLimit());
        }
    }

    function loadRecentTransactionsLimit() {
        const selector = document.getElementById('recent-transactions-limit');
        if (selector) {
            selector.value = String(getRecentTransactionsLimit());
        }
    }

    async function loadDashboard() {
        const now = new Date();
        const startOfThisMonth = new Date(now.getFullYear(), now.getMonth(), 1).toISOString().slice(0, 10);
        const endOfThisMonth   = new Date(now.getFullYear(), now.getMonth() + 1, 0, 23, 59, 59).toISOString().slice(0, 10);

        try {
            const [summary, monthlyBreakdown, trends, businesses, insights, receipts] = await Promise.all([
                window.PennyTrack.apiFetch('{{ path('api_dashboard_summary') }}').then(r => r.json()),
                window.PennyTrack.apiFetch(`{{ path('api_dashboard_monthly_breakdown') }}?months=${getBudgetChartMonths()}`).then(r => r.json()),
                window.PennyTrack.apiFetch('{{ path('api_dashboard_spending_over_time') }}').then(r => r.json()),
                window.PennyTrack.apiFetch(`{{ path('api_dashboard_top_businesses') }}?limit=${getTopBusinessesLimit()}`).then(r => r.json()),
                window.PennyTrack.apiFetch('{{ path('api_dashboard_insights') }}').then(r => r.json()),
                window.PennyTrack.apiFetch(`{{ path('api_receipts_list') }}?limit=${getRecentTransactionsLimit()}`).then(r => r.json()),
            ]);

            // Summary
            document.getElementById('summary-this-month').textContent = formatCurrency(summary.this_month_total);
            document.getElementById('summary-last-month').textContent = formatCurrency(summary.last_month_total);
            document.getElementById('summary-count').textContent = summary.this_month_count;
            document.getElementById('summary-avg').textContent = formatCurrency(summary.average_transaction);

            const changeEl = document.getElementById('summary-change');
            if (summary.month_over_month_change_percent > 0) {
                changeEl.textContent = `↑ ${summary.month_over_month_change_percent}% vs last month`;
                changeEl.className = 'text-xs text-red-600';
            } else if (summary.month_over_month_change_percent < 0) {
                changeEl.textContent = `↓ ${Math.abs(summary.month_over_month_change_percent)}% vs last month`;
                changeEl.className = 'text-xs text-green-600';
            } else {
                changeEl.textContent = '— same as last month';
                changeEl.className = 'text-xs text-gray-500';
            }

            // Insights
            if (insights.length > 0) {
                const container = document.getElementById('insights-container');
                const list = document.getElementById('insights-list');
                list.innerHTML = insights.map(i => {
                    const colors = { warning: 'bg-amber-50 text-amber-800 border-amber-200', success: 'bg-green-50 text-green-800 border-green-200', info: 'bg-blue-50 text-blue-800 border-blue-200' };
                    return `<div class="${colors[i.type] || colors.info} border rounded-lg px-4 py-3 text-sm">${i.message}</div>`;
                }).join('');
                container.classList.remove('hidden');
            }

            // Stacked Budget Chart
            if (budgetChart) budgetChart.destroy();
            const chartColors = ['#10b981', '#3b82f6', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899', '#6b7280',
                                 '#14b8a6', '#f97316', '#a855f7', '#06b6d4', '#84cc16'];

            // Format month labels: "2025-07" → "Jul 2025"
            const monthLabels = (monthlyBreakdown.months || []).map(m => {
                const [y, mo] = m.split('-');
                const d = new Date(parseInt(y), parseInt(mo) - 1, 1);
                return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
            });

            const datasets = (monthlyBreakdown.datasets || []).map((ds, i) => ({
                label: ds.category,
                data: ds.data,
                backgroundColor: chartColors[i % chartColors.length],
                borderRadius: 3,
            }));

            const budgetGoal = monthlyBreakdown.budget_goal;
            const hasData = datasets.some(ds => ds.data.some(v => v > 0));

            if (hasData) {
                // Calculate the max stacked total to set y-axis max nicely
                const monthlyTotals = monthLabels.map((_, i) =>
                    datasets.reduce((sum, ds) => sum + (ds.data[i] || 0), 0)
                );
                const maxSpent = Math.max(...monthlyTotals, 0);
                const yMax = budgetGoal ? Math.max(budgetGoal * 1.15, maxSpent * 1.1) : maxSpent * 1.1;

                // Build annotation plugins for budget line
                const budgetAnnotations = budgetGoal ? {
                    id: 'budgetLine',
                    afterDraw: (chart) => {
                        const ctx = chart.ctx;
                        const yAxis = chart.scales.y;
                        const xAxis = chart.scales.x;
                        const y = yAxis.getPixelForValue(budgetGoal);
                        if (y < yAxis.top || y > yAxis.bottom) return;

                        ctx.save();
                        ctx.strokeStyle = '#ef4444';
                        ctx.lineWidth = 2;
                        ctx.setLineDash([6, 4]);
                        ctx.beginPath();
                        ctx.moveTo(xAxis.left, y);
                        ctx.lineTo(xAxis.right, y);
                        ctx.stroke();
                        ctx.restore();

                        // Label
                        ctx.save();
                        ctx.fillStyle = '#ef4444';
                        ctx.font = 'bold 11px sans-serif';
                        ctx.textAlign = 'right';
                        ctx.fillText(`Budget: ${formatCurrency(budgetGoal)}`, xAxis.right - 4, y - 6);
                        ctx.restore();
                    }
                } : {};

                budgetChart = new Chart(document.getElementById('budget-chart'), {
                    type: 'bar',
                    data: {
                        labels: monthLabels,
                        datasets: datasets,
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: {
                                stacked: true,
                                grid: { display: false },
                                ticks: { font: { size: 11 } }
                            },
                            y: {
                                stacked: true,
                                beginAtZero: true,
                                max: yMax,
                                grid: { color: '#f3f4f6' },
                                ticks: {
                                    font: { size: 10 },
                                    callback: (v) => '$' + v.toFixed(0),
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { boxWidth: 12, font: { size: 11 } }
                            },
                            tooltip: {
                                callbacks: {
                                    label: (ctx) => ` ${ctx.dataset.label}: ${formatCurrency(ctx.parsed.y)}`,
                                    footer: (items) => {
                                        const total = items.reduce((s, i) => s + i.parsed.y, 0);
                                        return `Total: ${formatCurrency(total)}`;
                                    }
                                }
                            }
                        }
                    },
                    plugins: budgetGoal ? [budgetAnnotations] : []
                });
            } else {
                // No data placeholder
                budgetChart = new Chart(document.getElementById('budget-chart'), {
                    type: 'bar',
                    data: {
                        labels: monthLabels.length > 0 ? monthLabels : ['No data'],
                        datasets: [{
                            label: 'No data',
                            data: monthLabels.length > 0 ? monthLabels.map(() => 0) : [0],
                            backgroundColor: '#e5e7eb',
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { stacked: true },
                            y: { stacked: true, beginAtZero: true }
                        }
                    }
                });
            }

            // Trend Chart
            if (trendChart) trendChart.destroy();
            trendChart = new Chart(document.getElementById('trend-chart'), {
                type: 'bar',
                data: {
                    labels: trends.map(t => t.date.slice(5)),
                    datasets: [{
                        label: 'Spent',
                        data: trends.map(t => t.total),
                        backgroundColor: '#10b981',
                        borderRadius: 4,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { grid: { display: false }, ticks: { maxTicksLimit: 10, font: { size: 10 } } },
                        y: { beginAtZero: true, grid: { color: '#f3f4f6' }, ticks: { font: { size: 10 } } }
                    },
                    plugins: { legend: { display: false } }
                }
            });

            // Business Chart
            if (businessChart) businessChart.destroy();
            businessChart = new Chart(document.getElementById('business-chart'), {
                type: 'bar',
                data: {
                    labels: businesses.map(b => b.business),
                    datasets: [{
                        label: 'Total',
                        data: businesses.map(b => b.total),
                        backgroundColor: '#3b82f6',
                        borderRadius: 4,
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { beginAtZero: true, grid: { color: '#f3f4f6' }, ticks: { font: { size: 10 } } },
                        y: { grid: { display: false }, ticks: { font: { size: 11 } } }
                    },
                    plugins: { legend: { display: false } }
                }
            });

            // Recent Transactions
            const tbody = document.getElementById('recent-transactions');
            if (receipts.data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-8 text-center text-gray-500">No transactions yet. <a href="{{ path('app_receipt_new') }}" class="text-primary-600 hover:underline">Add one</a>!</td></tr>';
            } else {
                tbody.innerHTML = receipts.data.map(r => `
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3 text-gray-600">${formatDate(r.created_at)}</td>
                        <td class="px-4 py-3 font-medium text-gray-900">${r.business}</td>
                        <td class="px-4 py-3"><span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">${r.category}</span></td>
                        <td class="px-4 py-3 text-right font-semibold text-gray-900">${formatCurrency(r.amount)}</td>
                        <td class="px-4 py-3 text-right">
                            <button onclick="deleteReceipt(${r.id}, this)" class="text-red-500 hover:text-red-700 text-xs">Delete</button>
                        </td>
                    </tr>
                `).join('');
            }
        } catch (e) {
            console.error('Dashboard load failed', e);
        }
    }

    async function deleteReceipt(id, btn) {
        if (!confirm('Delete this receipt?')) return;
        btn.disabled = true;
        try {
            const res = await window.PennyTrack.apiFetch(`{{ path('api_receipts_list') }}/${id}`, { method: 'DELETE' });
            if (res.ok || res.status === 204) {
                loadDashboard();
            }
        } catch (e) {
            btn.disabled = false;
            alert('Failed to delete');
        }
    }

    // pull from local-storage and update selector on page
    loadTopBusinessesLimit();
    loadRecentTransactionsLimit();
    loadBudgetChartMonths();

    // Top Businesses limit selector
    document.getElementById('top-businesses-limit').addEventListener('change', (e) => {
        localStorage.setItem('pennyTrack_topBusinessesLimit', e.target.value);
        loadDashboard();
    });

    // Recent Transactions limit selector
    document.getElementById('recent-transactions-limit').addEventListener('change', (e) => {
        localStorage.setItem('pennyTrack_recentTransactionsLimit', e.target.value);
        loadDashboard();
    });

    // Budget chart months selector
    document.getElementById('budget-chart-months').addEventListener('change', (e) => {
        localStorage.setItem('pennyTrack_budgetChartMonths', e.target.value);
        loadDashboard();
    });

    loadDashboard();
</script>
{% endblock %}
